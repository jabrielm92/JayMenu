# Copy to .env and fill in real values: cp .env.example .env

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://jaymenu:jaymenu@localhost:5432/jaymenu?schema=public"
# Separate database used by `npm test` (created by docker/initdb)
TEST_DATABASE_URL="postgresql://jaymenu:jaymenu@localhost:5432/jaymenu_test?schema=public"

# Login is off unless this is "true" (then the NEXTAUTH_* and ADMIN_* values below are needed)
REQUIRE_LOGIN="false"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Admin user (only used when REQUIRE_LOGIN="true")
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
